{
  "name": "facturify",
  "version": "0.1.1",
  "description": "CLI to verify whether an agent payment actually settled on-chain.",
  "keywords": [
    "x402",
    "agentic-payments",
    "ai-agents",
    "stablecoin",
    "usdc",
    "settlement",
    "receipts",
    "cli",
    "payment-verification"
  ],
  "homepage": "https://facturify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernando-mendoza/facturify.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/fernando-mendoza/facturify/issues"
  },
  "author": "Fernando Mendoza <fernandomendozadev@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test \"test/*.test.js\""
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "facturify": "./dist/cli.js"
  },
  "dependencies": {
    "@facturify/core": "workspace:*",
    "@facturify/sdk": "workspace:*",
    "@facturify/rail-stellar": "workspace:*",
    "@facturify/rail-evm": "workspace:*",
    "@facturify/store": "workspace:*"
  }
}
